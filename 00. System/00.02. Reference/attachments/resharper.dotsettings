	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=0A97D2CC2B980045BBB582C79C86BD82/Scope/=139FF4CE89E7094686FDA7BF5FFBBE92/@KeyIndexDefined">True</s:Boolean>
	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=0A97D2CC2B980045BBB582C79C86BD82/Scope/=139FF4CE89E7094686FDA7BF5FFBBE92/Type/@EntryValue">Everywhere</s:String>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=F8C27FCD41CFC54BA15BDFE15EF95893/@KeyIndexDefined">True</s:Boolean>
	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=F8C27FCD41CFC54BA15BDFE15EF95893/Shortcut/@EntryValue">#pattern.designPattern.singleInstance</s:String>
	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=F8C27FCD41CFC54BA15BDFE15EF95893/Text/@EntryValue">	using (Mutex mutex = new Mutex(false, Process.GetCurrentProcess().ProcessName))&#xD;
	{&#xD;
		// Mutex의 소유권을 시도합니다. 이미 다른 인스턴스가 실행 중이라면,&#xD;
		// 해당 인스턴스가 소유한 Mutex를 획득할 수 없으므로 false를 반환합니다.&#xD;
		bool isOwned = mutex.WaitOne(TimeSpan.Zero, true);&#xD;
&#xD;
		if (isOwned)&#xD;
		{&#xD;
			Application.EnableVisualStyles();&#xD;
			Application.SetCompatibleTextRenderingDefault(false);&#xD;
			Application.Run(new MainForm());&#xD;
&#xD;
			// 애플리케이션을 종료하기 전에 Mutex를 반드시 해제해야 합니다.&#xD;
			mutex.ReleaseMutex();&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			// 이미 실행 중인 인스턴스가 있다면 사용자에게 알림을 줍니다.&#xD;
			Console.WriteLine("이미 다른 인스턴스가 실행 중입니다.");&#xD;
		}&#xD;
	}</s:String>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=F8C27FCD41CFC54BA15BDFE15EF95893/Reformat/@EntryValue">True</s:Boolean>
