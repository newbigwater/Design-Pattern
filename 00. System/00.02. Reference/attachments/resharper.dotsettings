	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=AA2216D49EB82E4D978C2CE84D7D01C7/Shortcut/@EntryValue">#pattern.thread</s:String>
	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=AA2216D49EB82E4D978C2CE84D7D01C7/Text/@EntryValue">	// Step 01. Thread Member Variable&#xD;
	private bool _thrdLoop$FunctionName$ = false;&#xD;
	private Thread _thrd$FunctionName$ = null;&#xD;
&#xD;
	// Step 02. Thread Creation&#xD;
	_thrd$FunctionName$ = new Thread(new ParameterizedThreadStart(on$FunctionName$Loop)) {IsBackground = true};&#xD;
	_thrdLoop$FunctionName$= true;&#xD;
	_thrd$FunctionName$.Start(null);&#xD;
&#xD;
	// Step 03. Termination and release of threads.&#xD;
	if (_thrdLoop$FunctionName$)&#xD;
	{&#xD;
		_thrdLoop$FunctionName$ = false;&#xD;
		if(_thrd$FunctionName$.Join(1000))&#xD;
			_thrd$FunctionName$.Abort("Shut-down");&#xD;
	}&#xD;
&#xD;
	// Step 04. Thread function.&#xD;
	public void on$FunctionName$Loop(object param)&#xD;
	{&#xD;
		while (_thrdLoop$FunctionName$)&#xD;
		{&#xD;
			Thread.Sleep(1);&#xD;
			$SELECTION$$END$&#xD;
		}&#xD;
	}</s:String>
