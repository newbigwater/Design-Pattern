<wpf:ResourceDictionary xml:space="preserve" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:System;assembly=mscorlib" xmlns:ss="urn:shemas-jetbrains-com:settings-storage-xaml" xmlns:wpf="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=091BC9DF47F3FE40A2E1926950EFE040/@KeyIndexDefined">True</s:Boolean>
	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=091BC9DF47F3FE40A2E1926950EFE040/Shortcut/@EntryValue">#format.annotation.summary</s:String>
	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=091BC9DF47F3FE40A2E1926950EFE040/Text/@EntryValue">	/// &lt;summary&gt;&#xD;
	/// Build System의 Batch file에 의해 빌드된 Assembly의 &lt;see cref="Version"/&gt;정보를 기반으로 빌드된 시간에 대한 &lt;see cref="T:System.DateTime" /&gt; 개체를 반환합니다.&#xD;
	/// &lt;/summary&gt;&#xD;
	/// &lt;param name="version"&gt;&#xD;
	/// Major Number.Minor Number.Build Number.Revision Number&#xD;
	/// &lt;br/&gt;Build Number : Days, 2000년 01월 01일 ~ 빌드된 날짜까지의 총 일(days) 수&#xD;
	/// &lt;br/&gt;Revision Number : Second, 00시 ~ 빌드된 시간까지의 총 초(second) 수&#xD;
	/// &lt;br/&gt;&#xD;
	/// &lt;br/&gt;매개 변수가 Null일 경우 : Assembly.GetExecutingAssembly()의 &lt;see cref="Version"/&gt; 취득&#xD;
	/// &lt;/param&gt;&#xD;
	/// &lt;returns&gt;&#xD;
	/// &lt;paramref name="version" /&gt; 매개 변수에 지정된 Build Number, Revision Number에 해당하는 &lt;see cref="T:System.DateTime" /&gt; 개체&#xD;
	/// &lt;/returns&gt;&#xD;
	/// &lt;example&gt;&#xD;
	/// &lt;code&gt;&#xD;
	/// var sum = Add(1, 2);&#xD;
	/// Console.WriteLine(sum); // 출력: 3&#xD;
	/// &lt;/code&gt;&#xD;
	/// &lt;/example&gt;&#xD;
	/// &lt;exception cref="System.OverflowException"&gt;&#xD;
	///	Thrown when one parameter is max and the other is greater than zero.&#xD;
	///&lt;/exception&gt;</s:String>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=091BC9DF47F3FE40A2E1926950EFE040/Reformat/@EntryValue">True</s:Boolean>
