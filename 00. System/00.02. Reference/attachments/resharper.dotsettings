	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=0A97D2CC2B980045BBB582C79C86BD82/Reformat/@EntryValue">True</s:Boolean>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=0A97D2CC2B980045BBB582C79C86BD82/ShortenQualifiedReferences/@EntryValue">True</s:Boolean>
